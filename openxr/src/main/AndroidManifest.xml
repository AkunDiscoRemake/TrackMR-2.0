<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM"/>
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"/>
        <intent><action android:name="org.khronos.openxr.OpenXRRuntimeService"/></intent>
    </queries>
    <application>
        <activity android:name="dev.trackmr.openxr.SessionActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="orientation|screenSize"/>
    </application>
</manifest>
